module Dither.Debug where

import Prelude

import Data.Array as Array
import Data.List.Lazy as LL

import Dither.State (DelayLine, DitherState, Fifo, RowLayer, RowState, SeededFifo(..), SeededLayer)

showFifoPreview :: Int -> Fifo -> String
showFifoPreview n fifo = 
  let preview = LL.toUnfoldable (LL.take n fifo) :: Array Number
  in show preview <> " ..."

showRowLayerPreview :: Int -> RowLayer -> String
showRowLayerPreview n layer =
  "[" <> Array.intercalate ", " (map (showFifoPreview n) layer) <> "]"

-- | Показывает превью одной SeededFifo: Constant — просто значение,
-- | Real — как обычную Fifo через showFifoPreview.
showSeededFifoPreview :: Int -> SeededFifo -> String
showSeededFifoPreview _ (Constant c) = "Constant " <> show c
showSeededFifoPreview n (Real fifo) = "Real " <> showFifoPreview n fifo

showSeededLayerPreview :: Int -> SeededLayer -> String
showSeededLayerPreview n layer =
  "[" <> Array.intercalate ", " (map (showSeededFifoPreview n) layer) <> "]"

showDelayLinePreview :: Int -> Int -> DelayLine -> String
showDelayLinePreview m n delayLine =
  let layers = LL.toUnfoldable (LL.take m delayLine) :: Array SeededLayer
  in "[" <> Array.intercalate ", " (map (showSeededLayerPreview n) layers) <> "]"

showStatePreview :: Int -> Int -> DitherState -> String
showStatePreview m n state =
  "{ delayLines: [" <> Array.intercalate ", " (map (showDelayLinePreview m n) state.delayLines) <> "] }"

showRowStatePreview :: Int -> RowState -> String
showRowStatePreview n rowState =
  "{ current: " <> showRowLayerPreview n rowState.current
    <> ", matured: [" <> Array.intercalate ", " (map (showSeededLayerPreview n) rowState.matured) <> "]"
    <> ", building: [" <> Array.intercalate ", " (map (showRowLayerPreview n) rowState.building) <> "]"
    <> " }"